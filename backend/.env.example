# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JSearch API (RapidAPI)
JSEARCH_API_KEY=your_jsearch_api_key_here

# Retell AI Configuration (for Voice Interview)
RETELL_API_KEY=your_retell_api_key_here

# JWT Authentication Secrets (REQUIRED - Generate secure random strings)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here_change_in_production

NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000(do not change this line)

